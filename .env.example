# PostgreSQL connection is required. Other settings are optional.
DATABASE_URL=postgresql://journal:journal@localhost:5432/journal

# Docker Compose database password (default: journal). Use URL-safe characters.
# POSTGRES_PASSWORD=

# Require a password to open the journal (recommended when exposed beyond localhost).
# JOURNAL_PASSWORD=

# Encryption key source for broker credentials at rest.
# Default: a random key file generated in JOURNAL_DATA_DIR.
# JOURNAL_SECRET=

# Local encryption key and cache directory. Default: ./data
# JOURNAL_DATA_DIR=

# AI features (session recaps, trade critiques, ask-your-journal).
# Can also be set on the Settings page (stored encrypted).
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# If only OPENAI_API_KEY is set, OpenAI is selected automatically.
# If both keys are set, Anthropic stays the default until you choose a provider in Settings.
# Provider and model choices are saved in Settings; environment keys take precedence over saved keys.
# Route Anthropic or OpenAI requests through a gateway or proxy (defaults: the public APIs).
# ANTHROPIC_BASE_URL=
# OPENAI_BASE_URL=
# Local or third-party OpenAI-compatible servers (Ollama, LM Studio, OpenRouter...) are set up in Settings.

# Optional market data: no provider is configured or enabled by this template.
# Choose a connection or upload candle CSVs in Settings > Market data.
# Provider-specific environment configuration is documented in docs/market-data.md.

# Saxo personal OpenAPI app (server-only). Register this exact callback with Saxo.
# SAXO_APP_KEY=
# SAXO_APP_SECRET=
# SAXO_REDIRECT_URI=http://localhost:3000/api/saxo/callback
# SAXO_ENVIRONMENT=live
# SAXO_HISTORY_FROM=2000-01-01
